# Database
# Defaults to a local SQLite file so the app runs with zero setup.
# For PostgreSQL use e.g. postgresql+asyncpg://user:password@localhost:5432/talentlens
DATABASE_URL=sqlite+aiosqlite:///./talentlens.db
TEST_DATABASE_URL=sqlite+aiosqlite:///./talentlens_test.db

# OpenAI API (optional)
# Leave empty to use the built-in local embedding + heuristic analysis fallback.
OPENAI_API_KEY=

# JWT Secret
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_NAME=TalentLens
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
